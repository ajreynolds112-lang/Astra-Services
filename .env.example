# Copy to .env on your own computer. Never commit real credentials.
# A separate local PostgreSQL database; do not use the production database.
DATABASE_URL=postgresql://localhost:5432/astra

# Clerk development credentials for your localhost-enabled application.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional local Stripe SANDBOX secret. Blank leaves local payments unavailable.
# Only sk_test_ keys are accepted by the local launcher.
STRIPE_SECRET_KEY=
# Optional signing secret printed by `stripe listen` on your own computer.
STRIPE_WEBHOOK_SECRET=

# Optional: email delivery. Client mail requires a verified Resend sender.
RESEND_API_KEY=
ASTRA_EMAIL_FROM=

# Optional: local request delivery to the EXISTING private client app repository.
# Do not grant this token access to unrelated repositories.
GITHUB_TOKEN=

# Optional: Expo app listing/sync.
EXPO_TOKEN=

LOCAL_WEB_PORT=3000
LOCAL_API_PORT=8080
# Used only for client email links; retain the real published portal URL.
ASTRA_PUBLIC_URL=https://astra-services.org
