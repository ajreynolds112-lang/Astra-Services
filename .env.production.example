# Self-hosted production on the Mac. Copy to .env.production (never commit it).
# Used by: node scripts/production.mjs build|db|start

# Production database on this Mac (separate from the dev "astra" database).
DATABASE_URL=postgresql://localhost:5432/astra_production

# Clerk PRODUCTION instance for astra-services.org (pk_live_ / sk_live_).
# For staging, development keys (pk_test_ / sk_test_) work on any hostname.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe: sk_live_ for production, sk_test_ for staging. Blank = payments unavailable.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointing at <public url>/api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# Optional: set only to let the server create/manage that webhook itself.
STRIPE_WEBHOOK_URL=

RESEND_API_KEY=
ASTRA_EMAIL_FROM=
GITHUB_TOKEN=
EXPO_TOKEN=

ASTRA_PUBLIC_URL=https://astra-services.org
# Loopback port the Cloudflare tunnel forwards to.
ASTRA_PORT=8090
